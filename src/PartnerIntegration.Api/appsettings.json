{
  "Security": {
    "ApiKey": "dev-partner-api-key",
    "HeaderName": "X-Api-Key"
  },
  "PartnerVerification": {
    "BaseUrl": "http://localhost:5263",
    "TimeoutProbability": 0.3,
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 200,
    "RequestTimeoutSeconds": 5,
    "VerifyPathTemplate": "internal/v1/partners/{0}/verify"
  },
  "MessageBroker": {
    "Provider": "RabbitMQ",
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "QueueName": "partner.transactions"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
